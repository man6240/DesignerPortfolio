// Cloudflare Workers deploy: `npm run build`, then `npx wrangler deploy` uploads dist/ as a static site.
// _headers and _redirects in public/ are copied into dist/ and honoured by Workers static assets.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "designerportfolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
